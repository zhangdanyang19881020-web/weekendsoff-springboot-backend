{
    "openapi": "3.1.0",
    "info": {
        "title": "weekendsoff-backend",
        "description": "公司双休查询后端 API（可导入 Apipost / Apifox）",
        "version": "0.0.1-SNAPSHOT"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8080",
            "description": "Generated server url"
        }
    ],
    "paths": {
        "/api/companies/{id}": {
            "put": {
                "tags": [
                    "company-controller"
                ],
                "operationId": "updateCompany",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CompanyUpdateDTO"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ResultVoid"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "company-controller"
                ],
                "operationId": "deleteCompany",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ResultInteger"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/companies/addCompany": {
            "post": {
                "tags": [
                    "company-controller"
                ],
                "operationId": "addCompany",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CompanyAddDTO"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ResultCompany"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/company": {
            "get": {
                "tags": [
                    "company-controller"
                ],
                "operationId": "getCompany",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {}
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/company/{id}": {
            "get": {
                "tags": [
                    "company-controller"
                ],
                "operationId": "getCompanyById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ResultCompanyResponseDTO"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/companies": {
            "get": {
                "tags": [
                    "company-controller"
                ],
                "summary": "\u83b7\u53d6\u516c\u53f8\u5217\u8868",
                "description": "\u6839\u636e\u9875\u7801\u548c\u6bcf\u9875\u6570\u91cf\u67e5\u8be2\u516c\u53f8\u5217\u8868",
                "operationId": "getCompanyList",
                "parameters": [
                    {
                        "name": "query",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/CompanyQueryDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ResultPageResultCompany"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CompanyUpdateDTO": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 0
                    },
                    "city": {
                        "type": "string",
                        "minLength": 1
                    },
                    "weekendsOff": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "city",
                    "name",
                    "weekendsOff"
                ]
            },
            "ResultVoid": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "message": {
                        "type": "string"
                    },
                    "data": {}
                }
            },
            "CompanyAddDTO": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 0
                    },
                    "city": {
                        "type": "string",
                        "minLength": 1
                    },
                    "weekendsOff": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "city",
                    "name",
                    "weekendsOff"
                ]
            },
            "Company": {
                "type": "object",
                "description": "\u516c\u53f8\u4fe1\u606f",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "\u516c\u53f8ID",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "description": "\u516c\u53f8\u540d\u79f0",
                        "example": "\u516c\u53f81",
                        "maxLength": 100,
                        "minLength": 2
                    },
                    "weekendsOff": {
                        "type": "boolean",
                        "description": "\u662f\u5426\u53cc\u4f11",
                        "example": true
                    },
                    "city": {
                        "type": "string",
                        "description": "\u57ce\u5e02",
                        "example": "\u5317\u4eac",
                        "minLength": 1
                    }
                },
                "required": [
                    "city",
                    "name",
                    "weekendsOff"
                ]
            },
            "ResultCompany": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "message": {
                        "type": "string"
                    },
                    "data": {
                        "$ref": "#/components/schemas/Company"
                    }
                }
            },
            "CompanyResponseDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "weekendsOff": {
                        "type": "boolean"
                    }
                }
            },
            "ResultCompanyResponseDTO": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "message": {
                        "type": "string"
                    },
                    "data": {
                        "$ref": "#/components/schemas/CompanyResponseDTO"
                    }
                }
            },
            "CompanyQueryDTO": {
                "type": "object",
                "properties": {
                    "page": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "pageSize": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "city": {
                        "type": "string"
                    },
                    "weekendsOff": {
                        "type": "boolean"
                    },
                    "keyword": {
                        "type": "string"
                    }
                }
            },
            "PageResultCompany": {
                "type": "object",
                "properties": {
                    "list": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Company"
                        }
                    },
                    "total": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "page": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "pageSize": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "ResultPageResultCompany": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "message": {
                        "type": "string"
                    },
                    "data": {
                        "$ref": "#/components/schemas/PageResultCompany"
                    }
                }
            },
            "ResultInteger": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "message": {
                        "type": "string"
                    },
                    "data": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            }
        }
    }
}
